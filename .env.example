# Postgres connection used by packages/db (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cost_reporting

# apps/api
API_PORT=4000
# 32-byte base64 key used to encrypt connector credentials at rest
ENCRYPTION_KEY=changeme-generate-a-32-byte-base64-key

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Provider credentials ---
# Not set here: each connector's credentials (Claude Analytics API key, AWS role,
# Datadog keys, ...) are entered as JSON on the Connectors page and stored
# encrypted. See "Setting up connectors" in the README.
#
# Exception: an AWS connector with no roleArn/profile/keys falls back to the API
# server's default AWS credential chain, which reads variables such as these:
# AWS_PROFILE=

# --- Notification channels ---
# Slack and generic webhook URLs are set per notification channel in the UI.
# Email channels send through this SMTP server:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=cost-reports@example.com
