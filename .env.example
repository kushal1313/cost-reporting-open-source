# Postgres connection used by packages/db (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cost_reporting

# apps/api
API_PORT=4000
# 32-byte base64 key used to encrypt connector credentials at rest
ENCRYPTION_KEY=changeme-generate-a-32-byte-base64-key

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Provider credentials (per connector instance; these are examples, not global config) ---
# AWS: prefer an IAM role (roleArn) with ce:GetCostAndUsage read-only access over static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ROLE_ARN=

# Datadog
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com

# Grafana Cloud
# GRAFANA_CLOUD_ORG_SLUG=
# GRAFANA_CLOUD_ACCESS_TOKEN=

# --- Notification channels ---
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=cost-reports@example.com
