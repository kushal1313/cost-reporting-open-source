# Dependencies
node_modules/

# Build output
dist/
build/
out/
.next/
.next-verify/
.turbo/
*.tsbuildinfo

# Prisma generated client (regenerated via `npm run db:generate`)
packages/db/generated/

# Test coverage
coverage/
.nyc_output/

# Env files — everything matching .env.* is ignored, then explicitly
# un-ignored for .env.example so the template itself stays tracked.
.env
.env.*
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.eslintcache

# Editor / OS
.DS_Store
Thumbs.db
.idea/
